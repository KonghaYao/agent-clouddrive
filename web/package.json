{
  "name": "agent-clouddrive-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:browser:acceptance": "node scripts/browser-acceptance.mjs",
    "test:browser:setup": "node scripts/browser-acceptance-setup.mjs",
    "test:browser:driver": "node --test scripts/browser-acceptance-unit.mjs",
    "test:large-upload": "node scripts/large-upload-acceptance.mjs",
    "test:large-upload-unit": "node --test scripts/large-upload-unit.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@uppy/core": "6.3.0",
    "@uppy/dashboard": "6.0.2",
    "@uppy/react": "6.1.0",
    "@uppy/tus": "6.0.0",
    "antd": "6.6.7",
    "oidc-client-ts": "3.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
