# Generate real secret files and .env with python3 setup.py --mode s3.
# These are project variables, not claimed to be oCIS native variables.
DRIVE_BIND_ADDRESS=127.0.0.1
DRIVE_PORT=8080
DRIVE_HOSTNAME=drive.localhost
DRIVE_PUBLIC_URL=http://drive.localhost:8080
DRIVE_MCP_PUBLIC_URL=http://drive.localhost:8080/mcp
DRIVE_ALLOWED_ORIGINS=http://drive.localhost:8080
DRIVE_OIDC_ISSUER=http://drive.localhost:8080/identity/realms/clouddrive
DRIVE_OAUTH_AUDIENCE=agent-clouddrive
DRIVE_WEB_CLIENT_ID=clouddrive-web
DRIVE_OCIS_INTERNAL_URL=http://ocis:9200
DRIVE_OCIS_AUDIENCE=ocis
DRIVE_OCIS_INTEGRATION_VERIFIED=false
DRIVE_DELEGATION_VERIFIED=false
DRIVE_TRASH_RESERVED_DIR=.clouddrive-retained
DRIVE_STORAGE_MODE=s3
STORAGE_USERS_DRIVER=s3ng
DRIVE_S3_ENDPOINT=http://rustfs:9000
DRIVE_S3_REGION=us-east-1
DRIVE_S3_ARTIFACT_BUCKET=clouddrive-artifacts
DRIVE_S3_FORCE_PATH_STYLE=true
DRIVE_MEILI_URL=http://meilisearch:7700
DRIVE_MEILI_INDEX=clouddrive
DRIVE_NATS_STREAM=CLOUDDRIVE
DRIVE_NODE_ID=single-node
DRIVE_UPLOAD_MAX_BYTES=21474836480
DRIVE_CONVERT_MAX_BYTES=104857600
DRIVE_CONVERT_MAX_PAGES=500
DRIVE_DEFAULT_QUOTA_BYTES=107374182400
DRIVE_JOB_LEASE_SECONDS=900
DRIVE_LISTEN=:8080
DRIVE_MCP_LISTEN=:8081
DRIVE_VISION_BASE_URL=
DRIVE_VISION_MODEL=
DRIVE_VISION_PROVIDER_ID=unconfigured
DRIVE_VISION_ALLOW_EXTERNAL=false
