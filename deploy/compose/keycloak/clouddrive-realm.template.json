{
  "realm": "clouddrive",
  "enabled": true,
  "displayName": "Agent CloudDrive",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      {
        "name": "offline_access",
        "description": "Offline access for explicit user-consented background processing"
      },
      {
        "name": "default-roles-clouddrive",
        "composite": true,
        "composites": {
          "realm": [
            "offline_access"
          ]
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-clouddrive",
    "composite": true,
    "clientRole": false
  },
  "eventsEnabled": true,
  "eventsListeners": [],
  "enabledEventTypes": ["UPDATE_PROFILE"],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "clientScopes": [
    {
      "name": "drive.read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "drive.read"
      }
    },
    {
      "name": "drive.write",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "drive.write"
      }
    },
    {
      "name": "drive.delete",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "drive.delete"
      }
    },
    {
      "name": "drive.restore",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "drive.restore"
      }
    },
    {
      "name": "drive.convert",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "drive.convert"
      }
    },
    {
      "name": "drive.share.request",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "drive.share.request"
      }
    },
    {
      "name": "drive.feedback",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "drive.feedback"
      }
    },
    {
      "name": "offline_access",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Allow background conversion to read your own files after you close the browser"
      }
    },
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "profile",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "profile preferred_username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "profile given_name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "firstName",
            "claim.name": "given_name",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "profile family_name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "lastName",
            "claim.name": "family_name",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "email",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "email verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "emailVerified",
            "claim.name": "email_verified",
            "jsonType.label": "boolean",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "roles",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "client roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "claim.name": "resource_access.${client_id}.roles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        },
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        },
        {
          "name": "audience resolve",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-resolve-mapper",
          "consentRequired": false,
          "config": {}
        }
      ]
    },
    {
      "name": "audience-drive",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "audience-drive",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "agent-clouddrive",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "mcp resource",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "__PUBLIC_URL__/mcp",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "audience-ocis",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "audience-ocis",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ocis",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "groups",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "true",
            "claim.name": "groups",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "ocis-roles",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "ocis user role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "claim.value": "[\"ocisUser\"]",
            "jsonType.label": "JSON",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "clouddrive-web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": true,
      "fullScopeAllowed": false,
      "redirectUris": [
        "__PUBLIC_URL__/auth/callback"
      ],
      "webOrigins": [
        "__PUBLIC_URL__"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "__PUBLIC_URL__/*"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "roles",
        "groups",
        "audience-drive"
      ],
      "optionalClientScopes": [
        "drive.read",
        "drive.write",
        "drive.delete",
        "drive.restore",
        "drive.convert",
        "drive.share.request",
        "drive.feedback"
      ]
    },
    {
      "clientId": "peri",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": true,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "__PUBLIC_URL__/*"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "roles",
        "groups",
        "audience-drive"
      ],
      "optionalClientScopes": [
        "drive.read",
        "drive.write",
        "drive.delete",
        "drive.restore",
        "drive.convert",
        "drive.share.request",
        "drive.feedback"
      ]
    },
    {
      "clientId": "agent-clouddrive",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "__BACKEND_CLIENT_SECRET__",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "attributes": {
        "standard.token.exchange.enabled": "true"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "groups",
        "ocis-roles",
        "audience-ocis"
      ],
      "optionalClientScopes": [
        "drive.read",
        "drive.write",
        "drive.delete",
        "drive.restore",
        "drive.convert",
        "drive.share.request",
        "drive.feedback"
      ]
    },
    {
      "clientId": "clouddrive-background",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "__BACKGROUND_CLIENT_SECRET__",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "__PUBLIC_URL__/v1/delegation/callback"
      ],
      "webOrigins": [
        "__PUBLIC_URL__"
      ],
      "consentRequired": true,
      "fullScopeAllowed": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "groups",
        "audience-drive"
      ],
      "optionalClientScopes": [
        "drive.read",
        "drive.write",
        "drive.delete",
        "drive.restore",
        "drive.convert",
        "drive.share.request",
        "drive.feedback",
        "offline_access"
      ]
    },
    {
      "clientId": "ocis",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "groups",
        "ocis-roles"
      ]
    },
    {
      "clientId": "clouddrive-identity",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "__IDENTITY_CLIENT_SECRET__",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic",
        "roles"
      ]
    }
  ],
  "scopeMappings": [
    {
      "clientScope": "offline_access",
      "roles": [
        "offline_access"
      ]
    }
  ],
  "clientScopeMappings": {
    "realm-management": [
      {
        "client": "clouddrive-identity",
        "roles": [
          "view-users",
          "query-users",
          "view-events"
        ]
      }
    ]
  },
  "users": [
    {
      "username": "service-account-clouddrive-identity",
      "enabled": true,
      "serviceAccountClientId": "clouddrive-identity",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "query-users",
          "view-events"
        ]
      }
    }
  ]
}
